{
  "name": "qryptchat-web",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "bin": {
    "qc": "./bin/qc.js",
    "qryptchat": "./bin/qc.js",
    "qryptchat-agent": "./bin/qryptchat-agent.js"
  },
  "packageManager": "bun@1.4.0",
  "scripts": {
    "lint:oxlint": "oxlint",
    "lint:oxlint:fix": "oxlint --fix",
    "cli": "bun bin/qc.js",
    "agent": "bun bin/qryptchat-agent.js",
    "qc": "bun bin/qc.js",
    "build:qc": "bun scripts/build-qc.js",
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "test": "bun --bun vitest",
    "test:ci": "bun --bun vitest run",
    "test:quarantined": "bun --bun vitest run --config vitest.quarantine.config.js",
    "test:ui": "bun --bun vitest --ui",
    "test:coverage": "bun --bun vitest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons:generate": "bun scripts/generate-icons.js",
    "icons:install": "scripts/install-desktop-icons.sh",
    "postinstall": "command -v pnpm && pnpm dlx @socketsecurity/socket-patch apply --silent --ecosystems npm || true",
    "dependencies": "command -v pnpm && pnpm dlx @socketsecurity/socket-patch apply --silent --ecosystems npm || true"
  },
  "devDependencies": {
    "@profullstack/hqtui": "^0.8.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/ui": "^4.1.8",
    "chai": "^6.0.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "15.5.27",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.7.0",
    "jsdom": "^26.1.0",
    "mocha": "^11.7.5",
    "msw": "^2.10.5",
    "oxlint": "^1.69.0",
    "prettier": "^3.6.2",
    "sharp": "^0.34.4",
    "sinon": "^21.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.8",
    "ws": "^8.18.3"
  },
  "dependencies": {
    "@noble/ciphers": "^2.0.0",
    "@noble/hashes": "^2.0.0",
    "@profullstack/autoblog": "github:profullstack/autoblog#75e54af77cbcf61dbd90fb3ed529c1b2dad1ed6f",
    "@profullstack/stack": "^0.1.3",
    "@profullstack/text-type-detection": "^1.0.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.56.0",
    "blessed": "^0.1.81",
    "dilithium-crystals": "^1.0.6",
    "dotenv": "^17.2.2",
    "mlkem": "^2.5.0",
    "next": "15.5.27",
    "openpgp": "^6.2.0",
    "posthog-js": "^1.381.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "twilio": "^5.12.0",
    "uuid": "^11.1.0",
    "webrtc-adapter": "^9.0.3",
    "zustand": "^5.0.0"
  },
  "overrides": {
    "glob": ">=10.5.0",
    "jws": ">=3.2.3",
    "js-yaml": ">=4.1.1",
    "cookie": "1.1.1",
    "diff": "8.0.4",
    "serialize-javascript": "7.0.5",
    "postcss": ">=8.5.10",
    "axios": ">=1.8.2"
  },
  "trustedDependencies": [
    "esbuild",
    "msw",
    "sharp"
  ]
}
