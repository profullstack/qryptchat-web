{
  "name": "qryptchat-web",
  "private": true,
  "version": "0.16.1",
  "type": "module",
  "bin": {
    "qc": "./bin/qc.js",
    "qryptchat": "./bin/qc.js",
    "qryptchat-agent": "./bin/qryptchat-agent.js"
  },
  "packageManager": "bun@1.4.4",
  "scripts": {
    "lint:oxlint": "oxlint",
    "lint:oxlint:fix": "oxlint --fix",
    "cli": "bun bin/qc.js",
    "agent": "bun bin/qryptchat-agent.js",
    "qc": "bun bin/qc.js",
    "build:qc": "bun scripts/build-qc.js",
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "test": "bun --bun vitest",
    "test:ci": "bun --bun vitest run",
    "test:quarantined": "bun --bun vitest run --config vitest.quarantine.config.js",
    "test:ui": "bun --bun vitest --ui",
    "test:coverage": "bun --bun vitest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons:generate": "bun scripts/generate-icons.js",
    "icons:install": "scripts/install-desktop-icons.sh",
    "postinstall": "command -v pnpm && pnpm dlx @socketsecurity/socket-patch apply --silent --ecosystems npm || true",
    "dependencies": "command -v pnpm && pnpm dlx @socketsecurity/socket-patch apply --silent --ecosystems npm || true"
  },
  "devDependencies": {
    "@profullstack/hqtui": "^0.11.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/ui": "^4.1.12",
    "chai": "^6.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "mocha": "^12.0.3",
    "msw": "^3.0.3",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "sinon": "^22.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@profullstack/autoblog": "github:profullstack/autoblog#75e54af77cbcf61dbd90fb3ed529c1b2dad1ed6f",
    "@profullstack/encrypt": "^0.1.0",
    "@profullstack/footer": "latest",
    "@profullstack/openprofile": "^0.2.0",
    "@profullstack/pairux-embed": "^0.1.0",
    "@profullstack/stack": "^0.5.0",
    "@profullstack/text-type-detection": "^1.0.0",
    "@profullstack/x402-gateway": "^0.13.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@telnyx/webrtc": "2.28.0",
    "blessed": "^0.1.81",
    "dilithium-crystals": "^1.0.6",
    "dotenv": "^18.0.9",
    "libphonenumber-js": "1.13.15",
    "mlkem": "^2.7.0",
    "next": "16.4.3",
    "openpgp": "^6.3.2",
    "posthog-js": "^1.438.23",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "twilio": "^6.2.0",
    "uuid": "^14.0.3",
    "webrtc-adapter": "^9.0.6",
    "zustand": "^5.0.16"
  },
  "overrides": {
    "glob": ">=10.5.0",
    "jws": ">=3.2.3",
    "js-yaml": ">=4.1.1",
    "cookie": "1.1.1",
    "diff": "8.0.4",
    "serialize-javascript": "7.1.4",
    "postcss": ">=8.5.10",
    "axios": ">=1.8.2",
    "dompurify": "3.4.17"
  },
  "trustedDependencies": [
    "esbuild",
    "msw",
    "sharp"
  ]
}
